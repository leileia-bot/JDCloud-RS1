#!/bin/sh

# JDRS Aero: 注册主题，并强制其为当前主题
# 登录页（露营剪影 + 大时钟）由主题模板渲染，只有 jdrs 生效时才存在，
# 所以这里直接锁死 mediaurlbase，不跟随其它主题。

changed=0

set_opt() {
	local key=$1
	local val=$2

	if [ "$(uci -q get "luci.$key")" != "$val" ]; then
		uci set "luci.$key=$val"
		changed=1
	fi
}

set_opt themes.JDRS /luci-static/jdrs
set_opt main.mediaurlbase /luci-static/jdrs
set_opt main.mediaurlbase_dark /luci-static/jdrs

[ "$changed" = 1 ] && uci commit luci

exit 0
