#!/bin/sh
#
# JDRS A 方案：首次启动把 overlay 所在 eMMC 分区在末尾扩满
# 原则：只做"把最后一段分区扩到磁盘末尾"，任何一步不满足就安静退出，不动数据
#

LOG=/tmp/jdrs-grow.log
exec >>"$LOG" 2>&1
echo "[grow] start $(date)"

ov=$(awk '$2=="/overlay"{print $1}' /proc/mounts | head -n1)
[ -n "$ov" ] || { echo "[grow] no /overlay mount, skip"; exit 0; }
echo "[grow] overlay dev: $ov"

case "$ov" in
	/dev/mmcblk*p*) disk=${ov%p*}; part=${ov##*p} ;;
	*) echo "[grow] not eMMC ($ov), skip"; exit 0 ;;
esac

[ -b "$disk" ] || { echo "[grow] no $disk, skip"; exit 0; }
command -v parted >/dev/null 2>&1 || { echo "[grow] parted missing, skip"; exit 0; }

lastpart=$(parted -m -s "$disk" unit s print 2>/dev/null |
	awk -F: 'NR>2 && $1 ~ /^[0-9]+$/ {n=$1} END{print n}')
echo "[grow] disk=$disk part=$part last=$lastpart"
[ "$lastpart" = "$part" ] || { echo "[grow] $part is not the last partition, skip"; exit 0; }

fstype=$(blkid -s TYPE -o value "$ov" 2>/dev/null)
echo "[grow] fs=$fstype"

before=$(df -k /overlay 2>/dev/null | awk 'NR==2{print $2}')
echo "[grow] size before: ${before}K"

case "$fstype" in
	ext2|ext3|ext4)
		e2fsck -p -f "$ov" >/dev/null 2>&1
		parted -s "$disk" unit s resizepart "$part" 100% || {
			echo "[grow] parted resizepart failed, skip"; exit 0; }
		partx -u "$disk" >/dev/null 2>&1
		resize2fs "$ov" || { echo "[grow] resize2fs failed"; exit 0; }
		;;
	f2fs)
		echo "[grow] f2fs overlay: online grow unsupported, skip"; exit 0 ;;
	*)
		echo "[grow] unsupported fs, skip"; exit 0 ;;
esac

sync
after=$(df -k /overlay 2>/dev/null | awk 'NR==2{print $2}')
echo "[grow] size after: ${after}K"
[ "${after:-0}" -gt "${before:-0}" ] && echo "[grow] OK, grew"
exit 0
